{
  "name": "kcg-portal-redesign-project",
  "version": "8.0.0",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "VITE_PORTAL_DISTRIBUTION_BUILD=1 wxt zip",
    "zip:firefox": "VITE_PORTAL_DISTRIBUTION_BUILD=1 wxt zip -b firefox",
    "zip:dev": "wxt zip",
    "zip:dev:firefox": "wxt zip -b firefox",
    "zip:all": "npm run zip:dev && npm run zip:dev:firefox && npm run zip && npm run zip:firefox",
    "postinstall": "wxt prepare",
    "lint": "eslint .",
    "type-coverage": "type-coverage --at-least 99.3 --strict",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e:flows": "playwright test --project=flows"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "lucide-react": "^1.63.0",
    "marked": "^18.1.2",
    "motion-icons-react": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitest/coverage-v8": "^5.0.5",
    "@wxt-dev/module-react": "^1.2.2",
    "autoprefixer": "^10.6.2",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "postcss-import": "^17.0.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "type-coverage": "^2.30.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wxt": "^0.21.5"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
